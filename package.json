{
  "name": "dohyuk-resume",
  "version": "1.0.0",
  "private": true,
  "description": "김도혁 프론트엔드 개발자 이력서",
  "scripts": {
    "build": "tailwindcss -i ./src/styles/main.css -o ./styles/main.css",
    "dev": "concurrently -k -n css,server -c blue,green \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./src/styles/main.css -o ./styles/main.css --watch",
    "dev:server": "browser-sync start --server --files \"styles/main.css, index.html\" --port 5500 --no-ui --no-notify"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.4",
    "tailwindcss": "^3.4.14"
  }
}
